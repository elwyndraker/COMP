/* Problem 23: lexer for the calculator with variables */
%{
#include <stdlib.h>
#include <string.h>
#include "p23_calc.tab.h"      /* token codes + yylval, generated by bison -d */
%}

%option noyywrap
%option yylineno

%%
[ \t\r]+                 { /* skip */ }
\n                       { /* yylineno is bumped automatically */ }
"//".*                   { /* comment */ }
"print"                  { return PRINT; }
[0-9]+(\.[0-9]+)?        { yylval.num = atof(yytext); return NUMBER; }
[A-Za-z_][A-Za-z0-9_]*   { yylval.id  = strdup(yytext); return NAME; }
[-+*/()=;]               { return yytext[0]; }
.                        { fprintf(stderr, "Line %d: illegal character '%s'\n", yylineno, yytext); }
%%
